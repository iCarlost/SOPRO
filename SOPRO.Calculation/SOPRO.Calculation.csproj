<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>Sopro.Calculation</RootNamespace>
    <AssemblyName>Sopro.Calculation</AssemblyName>
    <PackageId>SOPRO.Calculation</PackageId>
    <Version>0.1.0</Version>
    <Authors>CEPM</Authors>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <PackageTags>calculation;pricing;construction;screen-precision</PackageTags>
    <Description>Nucleo de calculo SOPRO desacoplado: aritmetica con precision de pantalla, cascada de porcentajes y distribucion temporal con ajuste de residuo. Cero dependencias runtime; cero tipos SOPRO en la API publica; API publica en ingles.</Description>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <PackageReleaseNotes>Initial private preview of the standalone calculation engine.</PackageReleaseNotes>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <DebugType>portable</DebugType>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
  </PropertyGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="\" />
    <None Include="CHANGELOG.md" Pack="true" PackagePath="\" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="SOPRO.Application" />
    <InternalsVisibleTo Include="SOPRO.Tests" />
  </ItemGroup>

</Project>
